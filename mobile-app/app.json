{
  "expo": {
    "name": "Hostel Administration",
    "slug": "hostel-administration",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1E3A8A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hosteladmin.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#1E3A8A"
      },
      "package": "com.hosteladmin.app",
      "permissions": [
        "NOTIFICATIONS"
      ]
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#1E3A8A"
        }
      ],
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "7ba87ca3-3635-4eed-bee4-9b064d939185"
      }
    },
    "owner": "pa-va"
  }
}
