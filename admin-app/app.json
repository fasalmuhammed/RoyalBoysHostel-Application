{
  "expo": {
    "name": "Royal Boys Hostel",
    "slug": "hostel-manager-local",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "hostelmanager",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F1B45"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.royalboyshostel.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Take a photo of a student while adding them to the hostel register.",
        "NSPhotoLibraryUsageDescription": "Choose an existing photo for a student's record."
      }
    },
    "android": {
      "package": "com.royalboyshostel.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F1B45"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose an existing photo for a student's record.",
          "cameraPermission": "Take a photo of a student while adding them to the hostel register."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#2F55E8"
        }
      ],
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "fbd6f7dc-74b2-43f5-8a3c-c4929fda388f"
      }
    },
    "owner": "pa-va",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/fbd6f7dc-74b2-43f5-8a3c-c4929fda388f",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
