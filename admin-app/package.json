{
  "name": "hostel-admin-local",
  "version": "1.0.0",
  "main": "node_modules/expo/AppEntry.js",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "lint": "tsc --noEmit",
    "test": "tsc -p tests/tsconfig.build.json && node tests/cloud.test.js",
    "typecheck": "tsc --noEmit",
    "build:artifact": "expo export -p web --output-dir build/web && node scripts/build-artifact.mjs build/web build/artifact/hostel.html \"Royal Boys Hostel\"",
    "test:firebase": "tsc -p tests/tsconfig.build.json && firebase emulators:exec --project demo-hostel --only auth,firestore,storage \"node tests/firebase.test.js\"",
    "build:site": "expo export -p web --clear --output-dir build/site && node -e \"require('fs').copyFileSync('hosting/join.html','build/site/join.html')\"",
    "deploy:staging": "npm run build:site && firebase deploy --only firestore:rules,storage,functions,hosting --project royal-hostel-staging",
    "test:billing": "firebase emulators:exec --project demo-hostel --only firestore \"node functions/billing.test.js\""
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-navigation/bottom-tabs": "^7.18.18",
    "@react-navigation/native": "^7.3.18",
    "@react-navigation/native-stack": "^7.18.10",
    "crypto-js": "^4.2.0",
    "expo": "^54.0.0",
    "expo-blur": "~15.0.8",
    "expo-constants": "~18.0.14",
    "expo-crypto": "~15.0.9",
    "expo-device": "~8.0.10",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.24",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-notifications": "~0.32.17",
    "expo-print": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-updates": "~29.0.20",
    "fflate": "^0.8.3",
    "firebase": "^12.19.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "qrcode-generator": "^2.0.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@types/crypto-js": "^4.2.2",
    "@types/react": "~19.1.10",
    "babel-preset-expo": "~54.0.0",
    "firebase-admin": "^13.10.0",
    "firebase-tools": "^14.27.0",
    "typescript": "~5.9.2"
  }
}
