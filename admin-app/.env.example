# The Firebase project this build uses. Copy to .env and fill in from
# Firebase console > Project settings > Your apps > Web app.
EXPO_PUBLIC_FIREBASE_API_KEY=your-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
EXPO_PUBLIC_FIREBASE_APP_ID=your-app-id

# Local development only: use the Firebase emulators on this computer.
# Android emulator: 10.0.2.2. A phone on the same Wi-Fi: this PC's address.
# EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=127.0.0.1
